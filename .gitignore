# Dependencies
node_modules/

# Local auth database — users, bcrypt hashes, sessions, builds, reset tokens
# Railway: mount a persistent volume at /app/var (never /app/data)
var/
data/auth.json
data/auth.json.tmp
data/auth.json.*

# Secrets / environment (never commit — set vars in Railway or a local .env)
.env
.env.*
.env.example

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
.cursor/
*.swp
*.swo

# Atomic write temp files (auth DB saves)
*.tmp

# Downloaded recipe XML (regenerated by npm run recipes:sync)
data/recipes-v2.1.xml
data/recipes-*.xml

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# TLS / keys (never commit)
*.pem
*.key
*.p12
*.crt

# Optional local overrides (e.g. custom recipe mirror paths)
*.local

# Mod preview videos — too large for GitHub (>100 MB).
# See TODO.md for the long-term hosting plan.
videos/remote-inventory-tablet-v2.mp4
